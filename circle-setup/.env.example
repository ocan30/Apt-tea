# Circle Developer-Controlled Wallets Credentials
# Get these from https://console.circle.com

# Your API Key (Sandbox starts with "TEST_API_KEY:", Production with "LIVE_API_KEY:")
CIRCLE_API_KEY=TEST_API_KEY:xxxxxxxxxxxxxxxxxxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Entity Secret (32-byte hex string, 64 characters)
# Generate with: node generate-entity-secret.js
# Then register in Circle Console: Configurator -> Dev-Controlled Wallets
CIRCLE_ENTITY_SECRET=your_64_character_hex_entity_secret_here
